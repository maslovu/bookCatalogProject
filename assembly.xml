<assembly xmlns="http://maven.apache.org/plugins/maven-assembly-plugin/assembly/1.1.3"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/plugins/maven-assembly-plugin/assembly/1.1.3
                    https://maven.apache.org/xsd/assembly-1.1.3.xsd">
    <id>schema-zip</id>
    <formats>
        <format>zip</format> <!-- Формат архива -->
    </formats>
    <includeBaseDirectory>false</includeBaseDirectory>
    <fileSets>
        <fileSet>
            <!-- Откуда берем файлы миграций Liquibase -->
            <directory>src/main/resources/changelog</directory>
            <!-- Куда складываем их внутри итогового ZIP-архива -->
            <outputDirectory>/</outputDirectory>
            <includes>
                <include>**/*.yaml</include>
                <include>**/*.xml</include>
                <include>**/*.sql</include>
            </includes>
        </fileSet>
    </fileSets>
</assembly>